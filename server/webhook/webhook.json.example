[
  {
    "id": "deploy-glowfit",
    "execute-command": "/var/www/glowfit/deploy.sh",
    "command-working-directory": "/var/www/glowfit",
    "response-message": "Deployment triggered",
    "trigger-rule": {
      "match": {
        "type": "payload-hmac-sha256",
        "secret": "REPLACE_WITH_THE_GITHUB_WEBHOOK_SECRET",
        "parameter": {
          "source": "header",
          "name": "X-Hub-Signature-256"
        }
      }
    }
  }
]
