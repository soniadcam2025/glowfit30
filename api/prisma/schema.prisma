generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  super_admin
  admin
  user
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  password     String?
  role         UserRole  @default(user)
  isBlocked    Boolean   @default(false) @map("is_blocked")
  createdAt    DateTime  @default(now()) @map("created_at")

  // Firebase / social login fields
  firebaseUid  String?   @unique @map("firebase_uid")
  photoUrl     String?   @map("photo_url")

  // Push notification token
  fcmToken     String?   @map("fcm_token")

  // Onboarding profile fields
  fitnessLevel String?   @map("fitness_level")
  goal         String?   @map("goal")
  dietStyle    String?   @map("diet_style")
  targetWeight Float?    @map("target_weight")
  focusAreas   String[]  @map("focus_areas")
  dob          DateTime? @map("dob")
  height       Float?    @map("height")
  weight       Float?    @map("weight")

  // Preferences
  waterGoalLiters Float   @default(3.0) @map("water_goal_liters")
  pushEnabled     Boolean @default(true) @map("push_enabled")

  adminLogs    AdminLog[]
  progress     Progress[]

  @@map("users")
}

model Workout {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  level       String
  duration    Int
  imageUrl    String?      @map("image_url")
  description String?      @db.Text
  goal        String?
  createdAt   DateTime     @default(now()) @map("created_at")

  days        WorkoutDay[]

  @@map("workouts")
}

model WorkoutDay {
  id         String     @id @default(uuid()) @db.Uuid
  workoutId  String     @map("workout_id") @db.Uuid
  workout    Workout    @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  dayNumber  Int        @map("day_number")
  title      String
  focus      String?
  imageUrl   String?    @map("image_url")
  durationMinutes Int?  @map("duration_minutes")
  kcal       Int?
  createdAt  DateTime   @default(now()) @map("created_at")

  exercises  Exercise[]
  progress   Progress[]

  @@index([workoutId])
  @@map("workout_days")
}

model Exercise {
  id           String     @id @default(uuid()) @db.Uuid
  workoutDayId String     @map("workout_day_id") @db.Uuid
  workoutDay   WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  name         String
  sets         Int?
  reps         Int?
  duration     Int?
  rest         Int?
  imageUrl     String?    @map("image_url")
  gifUrl       String?    @map("gif_url")
  videoUrl     String?    @map("video_url")
  order        Int        @default(0)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([workoutDayId])
  @@map("exercises")
}

model Progress {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutDayId String     @map("workout_day_id") @db.Uuid
  workoutDay   WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  completedAt  DateTime   @default(now()) @map("completed_at")
  caloriesBurned Int?     @map("calories_burned")
  durationMin  Int?       @map("duration_min")

  @@unique([userId, workoutDayId])
  @@index([userId])
  @@map("progress")
}

model DietPlan {
  id        String   @id @default(uuid()) @db.Uuid
  type      String   // diet style: Vegetarian | Non-Vegetarian | Vegan | Balanced
  goal      String?  // optional fitness-goal tag: Weight Loss, Muscle Gain, ...
  calories  Int
  meals     Json     // legacy plan-level meals; per-day meals live in DietPlanDay
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")

  days      DietPlanDay[]

  @@map("diet_plans")
}

model DietPlanDay {
  id         String   @id @default(uuid()) @db.Uuid
  dietPlanId String   @map("diet_plan_id") @db.Uuid
  dietPlan   DietPlan @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)
  dayNumber  Int      @map("day_number")
  // Same shape the app already parses: { items: [...], tags: [...], waterTarget: n }
  meals      Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([dietPlanId, dayNumber])
  @@index([dietPlanId])
  @@map("diet_plan_days")
}

model WorkoutLibraryCategory {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique // matches WorkoutLibraryItem.category, e.g. "Abs"
  headingLine1    String   @map("heading_line1") // detail screen: "ABS" (pink)
  headingLine2    String   @map("heading_line2") // detail screen: "WORKOUTS" (dark)
  description     String   @db.Text // detail screen paragraph
  heroImageUrl    String?  @map("hero_image_url") // detail screen header photo
  tags            Json     // [{ emoji, label, background, foreground }]
  // -- card grid (main Workout Library screen) --
  section         String   @default("Body Goals") // groups cards: "Body Goals", "Body Weight Workouts", ...
  cardTagline     String   @default("") @map("card_tagline") // short 2-line hook, e.g. "One Workout.\nFull Impact."
  cardImageUrl    String?  @map("card_image_url") // small card illustration/photo
  cardBackground  String   @default("#EAE3FA") @map("card_background") // hex
  cardTitleColor  String   @default("#3D2E7C") @map("card_title_color") // hex
  order           Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("workout_library_categories")
}

model WorkoutLibraryItem {
  id              String   @id @default(uuid()) @db.Uuid
  isFeatured      Boolean  @default(false) @map("is_featured") // true = hero card on the library screen
  category        String   // tag shown on the detail screen, e.g. "Abs"
  difficulty      String   @default("Beginner") // Beginner | Intermediate | Advanced
  titleLine1      String   @map("title_line1") // "Belly Fat"
  titleScript     String   @map("title_script") // "Blast"
  description     String   @db.Text
  heroImageUrl    String?  @map("hero_image_url")
  durationMinutes Int      @map("duration_minutes")
  kcalLabel       String   @map("kcal_label") // e.g. "120-160", free text estimate
  focusLabel      String   @map("focus_label") // e.g. "Core Focus"
  tags            Json     // [{ emoji, label, background, foreground }]
  order           Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")

  exercises       WorkoutLibraryExercise[]

  @@map("workout_library_items")
}

model WorkoutLibraryExercise {
  id                   String             @id @default(uuid()) @db.Uuid
  workoutLibraryItemId String             @map("workout_library_item_id") @db.Uuid
  item                 WorkoutLibraryItem @relation(fields: [workoutLibraryItemId], references: [id], onDelete: Cascade)
  name                 String
  durationSeconds      Int                @map("duration_seconds")
  imageUrl             String?            @map("image_url")
  videoUrl             String?            @map("video_url")
  order                Int                @default(0)
  createdAt            DateTime           @default(now()) @map("created_at")

  @@index([workoutLibraryItemId])
  @@map("workout_library_exercises")
}

model BeautyPost {
  id            String   @id @default(uuid()) @db.Uuid
  title         String
  content       String   @db.Text
  imageUrl      String?  @map("image_url")
  tag           String   @default("SKINCARE") // e.g. "SKINCARE", "NUTRITION", "ROUTINE" — Glow Reads chip
  tagColor      String   @default("#C4185A") @map("tag_color")
  tagBackground String   @default("#FCE4EC") @map("tag_background")
  minutesRead   Int      @default(4) @map("minutes_read")
  order         Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("beauty_posts")
}

model GlowCategory {
  id         String   @id @default(uuid()) @db.Uuid
  emoji      String
  title      String
  subtitle   String
  background String   @default("#FCE4EC")
  order      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("glow_categories")
}

model GlowShort {
  id        String   @id @default(uuid()) @db.Uuid
  imageUrl  String?  @map("image_url")
  duration  String // e.g. "0:45"
  title     String
  views     String   @default("0 views") // free-text display estimate, e.g. "10.2k views"
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("glow_shorts")
}

model AdminLog {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@map("admin_logs")
}
