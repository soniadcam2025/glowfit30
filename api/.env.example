# GlowFit API — copy to api/.env, fill in real values, chmod 600.
# Real values live in your secret store, never in git. Schema: src/config/env.js

NODE_ENV=production
# Production runs the API on 3000 (nginx api.glowfit30.com → 127.0.0.1:3000).
# Local development uses 4000 (the admin's NEXT_PUBLIC_API_URL and Flutter debug builds expect it).
PORT=3000
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/glowfit_db
# If using SSH tunnel on local machine:
# DATABASE_URL=postgresql://user:password@127.0.0.1:5433/glowfit_db
JWT_SECRET=replace_with_strong_secret_min_16_chars
REDIS_URL=redis://127.0.0.1:6379

# Optional but recommended
JWT_EXPIRES_IN=7d
CORS_ORIGINS=https://admin.glowfit30.com
# Live admin (https://admin.glowfit30.com) only needs CORS_ORIGINS above — leave this false on the server:
CORS_ALLOW_LOCAL_DEV=false
# Set true only if you intentionally call this API from local Next.js (http://localhost:3001) against prod URL.
AUTH_COOKIE_NAME=token
AUTH_DEBUG=false
REGISTER_ENABLED=false

# Firebase (social login + push) — provide ONE of these.
# Full service-account JSON on a single line (recommended for production):
FIREBASE_SERVICE_ACCOUNT_JSON=
# …or just the project id, with GOOGLE_APPLICATION_CREDENTIALS pointing at the key file:
FIREBASE_PROJECT_ID=

# Vultr Object Storage (S3-compatible) — all uploaded images and videos live here, not on the VPS.
VULTR_S3_ENDPOINT=https://<region>.vultrobjects.com
VULTR_S3_REGION=<region>
VULTR_S3_ACCESS_KEY=replace_with_access_key
VULTR_S3_SECRET_KEY=replace_with_secret_key
VULTR_S3_BUCKET_EXERCISES=replace_with_bucket_name
VULTR_S3_BUCKET_DIET=replace_with_bucket_name
# "true" keeps the pre-optimisation upload alongside every clip.
KEEP_ORIGINAL_VIDEO=false
# Images are served through the Cloudflare Worker (infra/cloudflare). Leave unset to serve straight
# from the bucket — and leave it unset until media.glowfit30.com actually resolves.
MEDIA_CDN_BASE=https://media.glowfit30.com

# Only read by scripts/seed-admin.mjs (creating the first admin on an EMPTY database).
# Not needed when restoring a backup — admins come with the data.
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=
